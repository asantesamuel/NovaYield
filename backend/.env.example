NOVAYIELD_APP_NAME=Nova Yield API
NOVAYIELD_ENVIRONMENT=development
NOVAYIELD_API_V1_PREFIX=/api/v1
NOVAYIELD_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NOVAYIELD_MONGODB_URI=mongodb://localhost:27017
NOVAYIELD_MONGODB_DATABASE_NAME=nova_yield
NOVAYIELD_MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000
# POWER usually publishes recent GEOS-IT data within about two days. These
# source-aware checks do not apply an expiration time to old MERRA-2 history.
NOVAYIELD_NASA_RECENT_PUBLICATION_LAG_DAYS=3
NOVAYIELD_NASA_GEOS_IT_REPLACEMENT_LAG_DAYS=60
NOVAYIELD_NASA_GEOS_IT_RECHECK_INTERVAL_DAYS=30
# After a failed automatic refresh of a stale stored snapshot, serve that
# labeled cached period for this many minutes before trying NASA again. This
# marker is stored in MongoDB; explicit force_refresh bypasses the backoff.
NOVAYIELD_NASA_REFRESH_FAILURE_BACKOFF_MINUTES=30
NOVAYIELD_AUTH_SESSION_LIFETIME_SECONDS=3600
NOVAYIELD_AUTH_COOKIE_SECURE=false
# Generate a unique stable private value for local development or deployment with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# NOVAYIELD_CSRF_SECRET=
# Generate a separate stable value for privacy-preserving NASA snapshot location identity:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# NOVAYIELD_LOCATION_HASH_SECRET=
# Set only when the frontend must read the CSRF cookie from a sibling subdomain.
# NOVAYIELD_CSRF_COOKIE_DOMAIN=example.com
